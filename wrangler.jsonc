{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-ecalc",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
